# Server
NODE_ENV=development
PORT=5000

# Database (MySQL - system of record, per DATABASE_SCHEMA.md)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=university_food_system
DB_USER=foodapp
DB_PASSWORD=change_me
DB_LOGGING=false

# Auth (JWT contract shared with Member 1's auth service)
# Member 3 does NOT issue tokens — it only verifies them via this shared secret,
# so its middleware stays compatible with Member 1's /auth endpoints.
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=7d

# Business rules
PICKUP_WINDOW_MINUTES=15
SHOPKEEPER_OPEN_TIME=09:30
USER_ORDERING_OPEN_TIME=10:30

# CORS
CORS_ORIGIN=http://localhost:5173

# Expiry sweep job
ORDER_EXPIRY_SWEEP_INTERVAL_MS=60000

# Payment (Razorpay)
RAZORPAY_KEY_ID=your_razorpay_key_id_here
RAZORPAY_KEY_SECRET=your_razorpay_key_secret_here
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret_here

# ML Service
ML_SERVICE_URL=http://localhost:8000
ML_INTERNAL_API_KEY=change-me

# University Food Pre-Booking System — .gitignore

# Dependencies
node_modules/
.pnp
.pnp.js

# Build outputs
dist/
build/
.next/
out/

# Environment files — NEVER commit real credentials
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Python
__pycache__/
*.py[cod]
*$py.class
*.pyc
.Python
venv/
.venv/
env/
ENV/
*.egg-info/
.eggs/

# ML model artifacts (large binary files)
ml-service/model/*.joblib
ml-service/model/*.pkl
ml-service/data/*.csv

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime
pids/
*.pid
*.seed
*.pid.lock

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V7
.Trashes
ehthumbs.db
Thumbs.db

# IDEs
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Test coverage
coverage/
.nyc_output/

# Misc
*.tgz
*.tar.gz
